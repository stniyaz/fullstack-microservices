@model List<ResultFeatureDto>

@{
    ViewData["Title"] = "Features";
    ViewData["h1"] = "Feature actions";
    ViewData["v1"] = "Dashboard";
    ViewData["v2"] = "Features";
    ViewData["v3"] = null;

    var counter = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <div class="bs-example" data-example-id="bordered-table">
                    <table class="table table-bordered">
                        <thead class="thead-dark">
                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th>Icon</th>
                                <th>Update</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fts in Model)
                            {
                                counter++;
                                <tr>
                                    <th scope="row">@counter</th>
                                    <td>@fts.Title</td>
                                    <td>@fts.Icon</td>

                                    <td>
                                        <a asp-action="Update" asp-controller="feature" asp-route-id="@fts.FeatureId" class="btn btn-success">Update</a>
                                    </td>
                                    <td>
                                        <a asp-action="Delete" asp-controller="feature" asp-route-id="@fts.FeatureId" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this Feature?');">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a asp-controller="feature" asp-action="create" class="btn btn-primary">Create new Feature</a>
                </div>
            </div>
        </div>
    </div>
</section>