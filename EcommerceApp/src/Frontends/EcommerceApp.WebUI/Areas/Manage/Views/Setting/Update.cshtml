@model UpdateSettingDto

@{
    ViewData["Title"] = "Settings";
    ViewData["h1"] = "Setting actions";
    ViewData["v1"] = "Dashboard";
    ViewData["v2"] = "Settings";
    ViewData["v3"] = "Update";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <input hidden asp-for="SettingId" />
                        <br />

                        <div class="form-group">
                            <label asp-for="Value"></label>
                            <textarea class="form-control" asp-for="Value"
                                      style="max-width: 600px; font-size: 14px; padding: 0.25rem 0.5rem;"></textarea>
                        </div>
                        <br />

                        <button type="submit" class="btn btn-success">Update</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>