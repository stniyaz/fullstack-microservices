@model List<ResultSendboxUserMessageDto>

@{
    ViewBag.Title = "Sendbox";

    var counter = 0;
}

<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Sendbox</h4>
                        <div class="table-responsive pt-3">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Receiver</th>
                                        <th>Subject</th>
                                        <th>Send Date</th>
                                        <th>Status</th>
                                        <th>Delete</th>
                                        <th>Open Messaage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        counter++;
                                        <tr>
                                            <th>@counter</th>
                                            <td>@item.ReceiverId</td>
                                            <td>@item.Subject</td>
                                            <td>@item.SendDate.ToString("dd MMM yyyy"))</td>
                                            <td>@item.IsRead</td>
                                            <td><a href="#" class="btn btn-danger">Delete</a></td>
                                            <td><a href="#" class="btn btn-info">Open Message</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>