@model List<ResultOrderingDto>

@{
    ViewBag.Title = "Active Orders";

    var counter = 0;

    string[] tableColours = { "table-info", "table-danger", "table-success" };
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Basic Table</h4>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Total Price</th>
                            <th>Order Date</th>
                            <th>Order Details</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var ords in Model.OrderByDescending(x => x.OrderDate))
                        {
                            string rowClass = tableColours[counter % tableColours.Length];
                            counter++;

                            <tr class="@rowClass">
                                <td>@counter</td>
                                <td>@ords.TotalPrice.ToString("F2")</td>
                                <td>@ords.OrderDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <a class="btn btn-info">Details</a>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>